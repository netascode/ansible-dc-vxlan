---
# This NDFC loopback interface data structure is auto-generated
# DO NOT EDIT MANUALLY
#

{# Var to set if ND has the 4.3.1.0175006011 patch #}
{%- set ndfc_supports_interface_properties =
  ndfc_version is defined
  and ((ndfc_version | cisco.nac_dc_vxlan.version_compare('12.6.0.267', '>'))
    or ((ndfc_version | cisco.nac_dc_vxlan.version_compare('12.6.0.267', '==')))
    and ('4.3.1.0175006011' in (nd_smu_versions | default([]))))
%}
{% set is_manual_allocation = false %}
{% set skip = false %}
{% if data_model_extended.vxlan.underlay is defined %}
{% set is_manual_allocation = data_model_extended.vxlan.underlay.general.manual_underlay_allocation | default(defaults.vxlan.underlay.general.manual_underlay_allocation) %}
{% set routing_lo_id =  data_model_extended.vxlan.underlay.general.underlay_routing_loopback_id %}
{% set vtep_lo_id =  data_model_extended.vxlan.underlay.general.underlay_vtep_loopback_id %}
{% endif %}

{% for switch in data_model_extended.vxlan.topology.switches %}
{% if switch.interfaces is defined %}
{% for interface in switch.interfaces %}
{% if interface.mode is defined and interface.mode in ['loopback', 'mpls_loopback', 'fabric_loopback'] %}
{% set intf_lower = interface.name.lower() %}
{# Exclude Loopback when use as Routing / VTEP Loopback with manual_underlay_allocation for VXLAN_EVPN #}
{% if is_manual_allocation is true %}
{% if (intf_lower == "loopback" ~ vtep_lo_id or intf_lower == "lo" ~ vtep_lo_id or intf_lower == "loopback" ~ routing_lo_id or intf_lower == "lo" ~ routing_lo_id) %}
{% set skip = true %}
{% endif %}
{% endif %}
{% if skip is false %}
- name: {{ interface.name }}
  type: lo
  switch:
{% if switch.management.management_ipv4_address is defined %}
    - {{ switch.management.management_ipv4_address}}
{% elif (switch.management.management_ipv4_address is not defined) and (switch.management.management_ipv6_address is defined)  %}
    - {{ switch.management.management_ipv6_address}}
{% endif %}
  deploy: false
  profile:
{% if interface.mode == 'loopback' %}
    mode: lo
{% elif interface.mode == 'mpls_loopback' %}
    mode: mpls
{% elif interface.mode == 'fabric_loopback' %}
    mode: fabric
{% endif %}
    int_vrf: {{ interface.vrf | default(omit) }}
    description: "{{ interface.description | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.description) }}"
    admin_state: {{ interface.enabled | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.enabled) | lower }}
    ipv4_addr: {{ interface.ipv4_address | default(omit) }}
    ipv6_addr: {{ interface.ipv6_address | default(omit) }}
    route_tag: {{ interface.ipv4_route_tag | default(omit) }}
{% if ndfc_supports_interface_properties %}
    enable_pim_sparse: {{ interface.enable_pim_sparse | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.enable_pim_sparse) | lower }}
{% if interface.eigrp_process_tag is defined %}
    eigrp_process_tag: {{ interface.eigrp_process_tag }}
    enable_eigrp_routing: {{ interface.enable_eigrp_routing | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.enable_eigrp_routing) | lower }}
    eigrp_no_ipv4_passive: {{ interface.eigrp_no_ipv4_passive | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.eigrp_no_ipv4_passive) | lower }}
    eigrp_ipv4_passive: {{ interface.eigrp_ipv4_passive | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.eigrp_ipv4_passive) | lower }}
    eigrp_no_ipv6_passive: {{ interface.eigrp_no_ipv6_passive | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.eigrp_no_ipv6_passive) | lower }}
    enable_eigrp_shutdown: {{ interface.enable_eigrp_shutdown | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.enable_eigrp_shutdown) | lower }}
    enable_eigrp_bfd: {{ interface.enable_eigrp_bfd | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.enable_eigrp_bfd) | lower }}
    disable_eigrp_bfd: {{ interface.disable_eigrp_bfd | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.disable_eigrp_bfd) | lower }}
{% endif %}
    enable_ospf: {{ interface.enable_ospf | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.enable_ospf) | lower }}
{% if interface.enable_ospf | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.enable_ospf) %}
    ospf_tag: {{ interface.ospf_tag | default(omit) }}
    ospf_area_id: {{ interface.ospf_area_id | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.ospf_area_id) }}
    enable_ospf_auth: {{ interface.enable_ospf_auth | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.enable_ospf_auth) | lower }}
{% if interface.enable_ospf_auth | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.enable_ospf_auth) %}
    ospf_auth_key_id: {{ interface.ospf_auth_key_id | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.ospf_auth_key_id) }}
    ospf_auth_key: {{ interface.ospf_auth_key | default(omit) }}
{% endif %}
    ospf_authentication_key_type: "{{ interface.ospf_authentication_key_type | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.ospf_authentication_key_type) }}"
    ospf_authentication_key: {{ interface.ospf_authentication_key | default(omit) }}
    ospf_advertise_subnet: {{ interface.ospf_advertise_subnet | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.ospf_advertise_subnet) | lower }}
    ospf_bfd: {{ interface.ospf_bfd | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.ospf_bfd) | lower }}
    ospf_cost: {{ interface.ospf_cost | default(omit) }}
    ospf_dead_interval: {{ interface.ospf_dead_interval | default(omit) }}
    ospf_hello_interval: {{ interface.ospf_hello_interval | default(omit) }}
    ospf_mtu_ignore: {{ interface.ospf_mtu_ignore | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.ospf_mtu_ignore) | lower }}
    ospf_network_type: {{ interface.ospf_network_type | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.ospf_network_type) }}
    ospf_priority: {{ interface.ospf_priority | default(omit) }}
    ospf_retransmit_interval: {{ interface.ospf_retransmit_interval | default(omit) }}
    ospf_shutdown: {{ interface.ospf_shutdown | default(defaults.vxlan.topology.switches.interfaces.topology_switch_loopback_interface.ospf_shutdown) | lower }}
    ospf_transmit_delay: {{ interface.ospf_transmit_delay | default(omit) }}
{% endif %}
{% endif %}
{# ------------------------------------------------------ #}
{# Todo: Need special handling for secondary ipv4 address and route_tag #}
{#       Module only supports one secondary and tag and no ipv6 support #}
{#       Also need to add freeform commands to the model? #}
{# ------------------------------------------------------ #}
    secondary_ipv4_addr: {{ interface.secondary_ipv4_addresses[0].ip_address | default(omit) }}
    cmds: |2-
      {{ interface.freeform_config | default('') | indent(6) }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
