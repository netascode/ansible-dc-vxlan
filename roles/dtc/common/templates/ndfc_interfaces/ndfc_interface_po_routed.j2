---
# This NDFC routed interface port-channel data structure is auto-generated
# DO NOT EDIT MANUALLY
#

{% for interface in interface_list %}
- name: {{ interface['name'] }}
  type: pc
  switch:
{% if interface['_mgmt_ipv4'] is defined %}
    - {{ interface['_mgmt_ipv4']}}
{% elif (interface['_mgmt_ipv4'] is not defined) and (interface['_mgmt_ipv6'] is defined)  %}
    - {{ interface['_mgmt_ipv6']}}
{% endif %}
  deploy: false
  profile:
    admin_state: {{ interface['enabled'] | default(interface_defaults.enabled) | lower }}
    mode: 'l3'
{% if interface['ipv4_address'] is defined %}
{% set ipv4_address__mask = interface['ipv4_address'].split('/') %}
    ipv4_addr: {{ ipv4_address__mask[0] | default(omit) }}
    ipv4_mask_len: {{ ipv4_address__mask[1] | default(omit) }}
{% endif %}
    description: "{{ interface['description'] | default(interface_defaults.description) }}"
    route_tag: {{ interface['ipv4_route_tag'] | default(omit) }}
    int_vrf: {{ interface['vrf'] | default(omit) }}
    mtu: {{ interface['mtu'] | default(interface_defaults.mtu) }}
    speed: {{ interface['speed'] | default(interface_defaults.speed) }}
    pc_mode: "{{ interface['pc_mode'] | default(interface_defaults.pc_mode) }}"
    members: {{ interface['members'] | default(omit) }}
    cmds: |2-
      {{ interface['freeform_config'] | default('') | indent(6, false) }}
{% endfor %}
