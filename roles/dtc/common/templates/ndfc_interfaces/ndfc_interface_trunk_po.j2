{% from 'macros/convert_ranges.j2' import convert_ranges as convert_ranges %}
---
# This NDFC trunk interface port-channel data structure is auto-generated
# DO NOT EDIT MANUALLY
#

{% for interface in interface_list %}
{% if interface['vpc_id'] is not defined %}
- name: {{ interface['name'] }}
  type: pc
  switch:
{% if interface['_mgmt_ipv4'] is defined %}
    - {{ interface['_mgmt_ipv4']}}
{% elif (interface['_mgmt_ipv4'] is not defined) and (interface['_mgmt_ipv6'] is defined)  %}
    - {{ interface['_mgmt_ipv6']}}
{% endif %}
  deploy: false
  profile:
    admin_state: {{ interface['enabled'] | default(interface_defaults.enabled) | lower }}
    mode: 'trunk'
    description: "{{ interface['description'] | default(interface_defaults.description) }}"
    mtu: {{ interface['mtu'] | default(interface_defaults.mtu) }}
    speed: {{ interface['speed'] | default(interface_defaults.speed) }}
    port_type_fast: {{ interface['spanning_tree_portfast'] | default(interface_defaults.spanning_tree_portfast) }}
    pc_mode: "{{ interface['pc_mode'] | default(interface_defaults.pc_mode) }}"
    members: {{ interface['members'] | default(omit) }}
    bpdu_guard: {{ interface['enable_bpdu_guard'] | default(interface_defaults.enable_bpdu_guard) | lower }}
    allowed_vlans: "{{ convert_ranges(interface['trunk_allowed_vlans'], interface_defaults.trunk_allowed_vlans) | trim }}"
    duplex: {{ interface['duplex'] | default(interface_defaults.duplex) }}
    disable_lacp_suspend_individual: {{ interface['disable_lacp_suspend_individual'] | default(interface_defaults.disable_lacp_suspend_individual) | lower }}
    lacp_port_priority: {{ interface['lacp_port_priority'] | default(interface_defaults.lacp_port_priority) }}
    lacp_rate: {{ interface['lacp_rate'] | default(interface_defaults.lacp_rate) }}
{% if interface['orphan_port'] | default(false) %}
    orphan_port: {{ interface['orphan_port'] | default(interface_defaults.orphan_port) | lower }}
{% endif %}
    native_vlan: "{{ interface['native_vlan'] | default(interface_defaults.native_vlan) }}"
    enable_qos: {{ interface['enable_qos'] | default(interface_defaults.enable_qos) | lower }}
{% if interface['enable_qos'] | default(interface_defaults.enable_qos) %}
    qos_policy: {{ interface['qos_policy'] | default("") }}
    queuing_policy: {{ interface['queuing_policy'] | default("") }}
{% endif %}
    enable_monitor: {{ interface['monitor'] | default(interface_defaults.monitor) | lower }}
    cmds: |2-
      {{ interface['freeform_config'] | default('') | indent(6, false) }}
{% endif %}
{% endfor %}
