{% from 'macros/translate_setting.j2' import translate %}
{% from 'macros/convert_ranges.j2' import convert_ranges as convert_ranges %}
---
# This NDFC PVLAN host interface data structure is auto-generated
# DO NOT EDIT MANUALLY
#

{# Var to set if ND has the 4.3.1.0175006011 patch #}
{%- set ndfc_supports_interface_properties =
  ndfc_version is defined
  and ((ndfc_version | cisco.nac_dc_vxlan.version_compare('12.6.0.267', '>'))
    or ((ndfc_version | cisco.nac_dc_vxlan.version_compare('12.6.0.267', '==')))
    and ('4.3.1.0175006011' in (nd_smu_versions | default([]))))
%}
{% for switch in data_model_extended.vxlan.topology.switches %}
{% if switch.interfaces is defined %}
{% for interface in switch['interfaces'] %}
{% set interface_name = interface['name']|lower %}
{% if interface_name.startswith('e') %}
{% if interface['mode'] == 'pvlan' %}
{% set pvlan_mode = interface['pvlan_mode'] %}
- name: {{ interface['name'] }}
  type: eth
  switch:
{% if switch.management.management_ipv4_address is defined %}
    - {{ switch.management.management_ipv4_address}}
{% elif (switch.management.management_ipv4_address is not defined) and (switch.management.management_ipv6_address is defined)  %}
    - {{ switch.management.management_ipv6_address}}
{% endif %}
  deploy: false
  profile:
    mode: pvlan
    pvlan_mode: "{{ pvlan_mode }}"
    admin_state: {{ interface['enabled'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.enabled) | lower }}
    enable_cdp: {{ interface['enable_cdp'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.enable_cdp) | lower }}
    description: "{{ interface['description'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.description) }}"
    mtu: {{ interface['mtu'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.mtu) }}
    speed: {{ interface['speed'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.speed) }}
    port_type_fast: {{ interface['spanning_tree_portfast'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.spanning_tree_portfast) | lower }}
    bpdu_guard: {{ interface['enable_bpdu_guard'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.enable_bpdu_guard) | lower }}
    duplex: {{ interface['duplex'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.duplex) }}
{% if interface['orphan_port'] | default(false) %}
    orphan_port: {{ interface['orphan_port'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.orphan_port) | lower }}
{% endif %}
    enable_pfc: {{ interface['enable_priority_flow_control'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.enable_priority_flow_control) | lower }}
    enable_qos: {{ interface['enable_qos'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.enable_qos) | lower }}
{% if interface['enable_qos'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.enable_qos) %}
    qos_policy: {{ interface['qos_policy'] | default("") }}
{% endif %}
{% if interface['queuing_policy'] is defined %}
    queuing_policy: {{ interface['queuing_policy'] | default("") }}
{% endif %}
{# Trunk submodes carry native_vlan and allowed_vlans #}
{% if pvlan_mode in ['trunk promiscuous', 'trunk secondary'] %}
    native_vlan: "{{ interface['native_vlan'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.native_vlan) }}"
    allowed_vlans: "{{ convert_ranges(interface['trunk_allowed_vlans'], defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.trunk_allowed_vlans) | trim }}"
{% endif %}
{# host / trunk secondary carry pvlan_association (primary/secondary single VLANs) #}
{% if pvlan_mode in ['host', 'trunk secondary'] and interface['pvlan_association'] is defined %}
    pvlan_association:
{% for assoc in interface['pvlan_association'] %}
      - primary_vlan: {{ assoc['primary_vlan'] }}
        secondary_vlan: {{ assoc['secondary_vlan'] }}
{% endfor %}
{% endif %}
{# promiscuous / trunk promiscuous carry pvlan_mapping (primary + secondary range string) #}
{% if pvlan_mode in ['promiscuous', 'trunk promiscuous'] and interface['pvlan_mapping'] is defined %}
    pvlan_mapping:
{% for mapping in interface['pvlan_mapping'] %}
      - primary_vlan: {{ mapping['primary_vlan'] }}
        secondary_vlans: "{{ convert_ranges(mapping['secondary_vlans'], '') | trim }}"
{% endfor %}
{% endif %}
{% if ndfc_supports_interface_properties %}
{# Data model defines ENABLE LLDP TRANSMIT/RECEIVE, while base collection defines DISABLE LLDP TRANSMIT/RECEIVE #}
{#     disable_lldp_transmit: {{ translate(interface['enable_lldp_transmit'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.enable_lldp_transmit), {true: 'false', false: 'true'}) }} #}
{#     disable_lldp_receive: {{ translate(interface['enable_lldp_receive'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_pvlan_interface.enable_lldp_receive), {true: 'false', false: 'true'}) }} #}
{% endif %}
    cmds: |2-
      {{ interface['freeform_config'] | default('') | indent(6, false) }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
